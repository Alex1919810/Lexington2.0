{
  "name": "desktop-pet",
  "version": "1.0.0",
  "description": "Electron + Vue3 桌面宠物应用",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:vite": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "electron-builder"
  },
  "keywords": [
    "electron",
    "vue3",
    "desktop-pet"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "debug": "^4.3.4",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "vue": "^3.4.15"
  },
  "overrides": {
    "extract-zip": {
      "eslint-config-standard": "^17.0.0"
    },
    "sumchecker": {
      "eslint-config-standard": "^17.0.0"
    }
  }
}
